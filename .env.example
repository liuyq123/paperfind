# OpenAI API key for embeddings and LLM
OPENAI_API_KEY=sk-...

# Zotero API key for library sync
ZOTERO_API_KEY=

# Zotero user ID
ZOTERO_USER_ID=

# Email for CrossRef API (polite pool)
CROSSREF_EMAIL=your_email@example.com

# SMTP settings for digest emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=paperfind@example.com
EMAIL_TO=you@example.com,teammate@example.com

# Custom data directory (optional)
PAPERFIND_DATA_DIR=

# Optional Postgres connection string (enables Postgres with daily/zotero schemas)
# Example: postgresql://user:password@localhost:5432/paperfind
PAPERFIND_DB_URL=

# Vector store backend: chroma (default) or pgvector (uses Postgres)
PAPERFIND_VECTOR_STORE=chroma

# Embedding provider and model
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Ollama server URL (optional)
OLLAMA_BASE_URL=http://localhost:11434

# Cross-encoder rerank model
RERANK_MODEL=mixedbread-ai/mxbai-rerank-base-v1

# =============================================================================
# Paper source categories (comma-separated)
# =============================================================================

# arXiv categories to fetch
# Default: q-bio.BM,q-bio.QM,q-bio.MN,cs.LG,cs.AI,stat.ML,physics.chem-ph,physics.bio-ph
# Set to empty string to fetch ALL categories (~100 categories, very slow):
#ARXIV_CATEGORIES=
# Or specify custom categories:
#ARXIV_CATEGORIES=cs.LG,cs.AI,stat.ML
# See https://arxiv.org/category_taxonomy for full list

# bioRxiv categories to fetch
# Default: bioinformatics,biochemistry,pharmacology-and-toxicology,systems-biology,
#          synthetic-biology,molecular-biology,cell-biology,genomics,biophysics
# Set to empty string to fetch ALL categories (no filtering):
#BIORXIV_CATEGORIES=
# Or specify custom categories:
#BIORXIV_CATEGORIES=bioinformatics,genomics,neuroscience

# medRxiv categories to fetch (default: all)
# Set to empty string to fetch ALL categories (no filtering):
#MEDRXIV_CATEGORIES=
