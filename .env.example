# OpenAI API key for embeddings and LLM
OPENAI_API_KEY=sk-...

# Zotero API key for library sync
ZOTERO_API_KEY=

# Zotero user ID
ZOTERO_USER_ID=

# Email for CrossRef API (polite pool)
CROSSREF_EMAIL=your_email@example.com

# SMTP settings for digest emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=paperfind@example.com
EMAIL_TO=you@example.com,teammate@example.com

# Custom data directory (optional)
PAPERFIND_DATA_DIR=

# Optional Postgres connection string (enables Postgres with daily/zotero schemas)
# Example: postgresql://user:password@localhost:5432/paperfind
PAPERFIND_DB_URL=

# Vector store backend: chroma (default) or pgvector (uses Postgres)
PAPERFIND_VECTOR_STORE=chroma

# Embedding provider and model
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Ollama server URL (optional)
OLLAMA_BASE_URL=http://localhost:11434

# LLM-based reranking (optional, for --rerank flag)
# Model to use for LLM reranking
LLM_RERANK_MODEL=gpt-4o-mini
# Or set preferences inline (alternative to rerank_preferences.txt file)
#LLM_RERANK_PREFERENCES=I'm interested in ML for drug discovery and protein design

# Default keywords for recommendations and digest (semicolon-separated)
# These are used when --keywords is not provided on the command line
#PAPERFIND_KEYWORDS=protein design;drug discovery;machine learning

# =============================================================================
# Paper source categories (comma-separated)
# =============================================================================

# arXiv categories to fetch
# Default: all q-bio.* + AI/ML (cs.AI,cs.CL,cs.CV,cs.IR,cs.LG,cs.NE,cs.RO,stat.ML) + physics.chem-ph,physics.bio-ph
# Set to empty string to fetch ALL categories (~100 categories, very slow):
#ARXIV_CATEGORIES=
# Or specify custom categories:
#ARXIV_CATEGORIES=cs.LG,cs.AI,stat.ML
# See https://arxiv.org/category_taxonomy for full list

# bioRxiv categories to fetch
# Default: bioinformatics,biochemistry,pharmacology-and-toxicology,systems-biology,
#          synthetic-biology,molecular-biology,cell-biology,genomics,genetics,biophysics
# Set to empty string to fetch ALL categories (no filtering):
#BIORXIV_CATEGORIES=
# Or specify custom categories:
#BIORXIV_CATEGORIES=bioinformatics,genomics,neuroscience

# medRxiv categories to fetch
# Default: genetic-and-genomic-medicine,health-informatics
# Set to empty string to fetch ALL categories (no filtering):
#MEDRXIV_CATEGORIES=

# ChemRxiv categories to fetch (uses category IDs)
# Default: Biological and Medicinal Chemistry, Theoretical and Computational Chemistry,
#          Physical Chemistry, Organic Chemistry
# Set to empty string to fetch ALL categories (no filtering):
#CHEMRXIV_CATEGORIES=
# Or specify custom category IDs (see https://chemrxiv.org/engage/chemrxiv/public-api/v1/categories):
#CHEMRXIV_CATEGORIES=605c72ef153207001f6470d0,605c72ef153207001f6470ce
# Common category IDs:
#   605c72ef153207001f6470d0 = Biological and Medicinal Chemistry
#   605c72ef153207001f6470ce = Theoretical and Computational Chemistry
#   605c72ef153207001f6470cf = Physical Chemistry
#   605c72ef153207001f6470d1 = Organic Chemistry
#   605c72ef153207001f6470d4 = Catalysis
#   605c72ef153207001f6470d3 = Inorganic Chemistry
#   605c72ef153207001f6470d5 = Analytical Chemistry
#   60b63c9f57d3ab002262a6f7 = Materials Chemistry
